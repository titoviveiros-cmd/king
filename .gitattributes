# Scripts que rodam na VPS precisam de LF: o `git show` entrega o blob como ele foi gravado,
# e um  no fim da linha faz o bash reclamar de comando inexistente.
*.sh text eol=lf

# Entrega B: o cabeçalho do rollout traz o sha256 da migração e a conferência (R1, --conferir) é
# byte a byte. Um checkout com CRLF faria o arquivo divergir do que foi aprovado.
supabase/rollout/cosmeticos-*.sql text eol=lf
supabase/rollout/partes/cosmeticos-*.sql text eol=lf
supabase/migrations/20261117120000_cosmeticos.sql text eol=lf
supabase/migrations/20261118120000_cosmeticos_mesa.sql text eol=lf
supabase/migrations/20261119120000_cosmeticos_catalogo.sql text eol=lf
supabase/migrations/20261120120000_recordes.sql text eol=lf
supabase/rollout/recordes-*.sql text eol=lf
supabase/rollout/partes/recordes-*.sql text eol=lf

# Entrega C (penalidade do Rei): mesma razão — sha256 da migração no cabeçalho do rollout.
supabase/migrations/20261121120000_xp_penalidade_rei.sql text eol=lf
supabase/rollout/xp-rei-*.sql text eol=lf
supabase/rollout/partes/xp-rei-*.sql text eol=lf
