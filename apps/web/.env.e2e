# Build usado SÓ pelos testes de ponta a ponta.
#
# Difere do build de produção em duas linhas. A primeira aponta o cliente para o Colyseus que o
# Playwright sobe em paralelo — é o que torna Lobby e Mesa multiplayer alcançáveis pelo teste, e
# metade dos defeitos que o iPhone real encontrou vivia justamente nessas duas telas. A segunda
# (no fim do arquivo) marca todo evento de analytics como tráfego de teste.
#
# Não é segredo: é um endereço de loopback.
VITE_KING_SERVER_URL=ws://localhost:2567

# Todo build de e2e é tráfego de TESTE: se um dia ganhar chave de analytics, não suja painel real.
VITE_KING_TRAFEGO=test
