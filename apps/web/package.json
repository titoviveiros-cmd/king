{
  "name": "@king/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test && npm run test:e2e:progresso && npm run test:e2e:analytics",
    "build:e2e": "vite build --mode e2e",
    "build:e2e-progresso": "vite build --mode e2e-progresso --outDir dist-e2e-progresso",
    "test:e2e:progresso": "npm run build:e2e-progresso && playwright test -c playwright.progresso.config.ts",
    "build:e2e-analytics": "vite build --mode e2e-analytics --outDir dist-e2e-analytics",
    "test:e2e:analytics": "npm run build:e2e-analytics && playwright test -c playwright.analytics.config.ts"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@fontsource/gabarito": "^5.0.0",
    "@fontsource/nunito": "^5.0.0",
    "@king/engine": "*",
    "@supabase/supabase-js": "^2.112.4",
    "posthog-js": "1.434.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "node-html-parser": "^9.0.1",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
