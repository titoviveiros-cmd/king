# Variáveis do servidor Colyseus do KING.
#
# Este processo NÃO precisa de nenhum segredo do Supabase. Ele só CONFERE assinaturas, e conferir
# se faz com a chave PÚBLICA do emissor, buscada no JWKS. Se um dia aparecer aqui uma
# `service_role` ou um `JWT secret`, é engano: um vazamento de leitura viraria vazamento de
# emissão, e qualquer pessoa poderia forjar a identidade de qualquer jogador.

PORT=2567

# ── IDENTIDADE PERMANENTE (opcional) ──
#
# O MODO É DECLARADO: KING_IDENTITY_MODE=legacy (MODO A) ou KING_IDENTITY_MODE=permanent (MODO B).
#   · sem modo e sem URL          → legacy (máquina local, CI)
#   · sem modo e com URL válida   → permanent (comportamento histórico, preservado)
#   · legacy                      → MODO A, mesmo com a URL presente (rollback sem apagar nada)
#   · permanent sem URL válida    → o processo NÃO sobe (código 78) — nunca cai para legacy
#   · qualquer outro valor        → o processo NÃO sobe (código 78)
#
# EM PRODUÇÃO a declaração mora em /etc/king/server.env, FORA do repositório, e é o próprio
# servidor que a lê no boot — não a shell que o reinicia. Sob o PM2 o arquivo é obrigatório, ele
# precisa declarar KING_IDENTITY_MODE, e para as três chaves abaixo ele é a única fonte. Só estas
# três chaves são aceitas nele; qualquer uma com cara de segredo é recusada.
#
#   /etc/king/server.env
#     KING_IDENTITY_MODE=legacy
#     SUPABASE_URL=https://<ref>.supabase.co
#
# Para voltar ao MODO A: trocar a primeira linha para legacy e reiniciar. Banco, usuários e perfis
# não são tocados. `KING_ENV_FILE` aponta outro caminho (e o torna obrigatório) — uso de teste.
KING_IDENTITY_MODE=
#
# Sem SUPABASE_URL, o servidor atende exatamente como sempre atendeu: sorteia um identificador na
# entrada e ele morre com a sala. Um cliente que mande token continua entrando — o token é
# simplesmente ignorado, porque não há com o que conferi-lo.
#
# Com ela (MODO B), a credencial passa a ser OBRIGATÓRIA: entrar SEM token é recusado com 4005, e
# entrar com token que não confere é recusado com 4003. Cliente antigo, ou cliente novo cujo
# provedor está fora do ar, não entra. Por isso a ordem de ativação é: publicar primeiro o cliente
# que manda token, e só depois definir SUPABASE_URL aqui.
#
# Só a URL do projeto. O emissor e o JWKS são derivados dela:
#   iss  = <SUPABASE_URL>/auth/v1
#   jwks = <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=

# O `aud` esperado. Deixe vazio para usar `authenticated`, que é o que o Supabase emite para
# sessão de usuário — inclusive anônima.
SUPABASE_JWT_AUDIENCE=
